# Canonical origin. Everything in schema, sitemap and llms.txt is built from it.
SITE_URL=https://casilla.example

# Whole-site indexing switch. Keep false until the ranking holds enough casinos
# to be worth crawling; an empty aggregator that gets indexed earns a thin-content
# reputation that takes months to shed.
SITE_INDEXABLE=false

# Include the placeholder casino records. Never true in production.
INCLUDE_DEMO=false

# Analytics. Each is optional; a tracker loads only when its ID is set.
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
PUBLIC_CF_BEACON_TOKEN=
