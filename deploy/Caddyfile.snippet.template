# Site block to add to the existing /etc/caddy/Caddyfile — append this, don't replace
# anything already in that file. Caddy issues and renews the TLS certificate for this
# block automatically the first time it starts serving it; nothing else to configure.

gambleatlas.com, www.gambleatlas.com {
	root * /var/www/gambleatlas/dist
	encode gzip zstd
	file_server

	# /go/{slug} affiliate redirects — regenerated by
	# `npx tsx scripts/build-caddy-redirects.ts` on every deploy. Paste the current
	# contents of deploy/go-redirects.caddy here in place of this comment.
}
