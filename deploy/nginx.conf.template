# nginx site config for gambleatlas.com — standalone file, does not touch any other
# vhost on the box. Copy to /etc/nginx/sites-available/gambleatlas.com, symlink into
# sites-enabled, then let certbot upgrade it to HTTPS in place (see deploy/README.md).

server {
    listen 80;
    listen [::]:80;
    server_name gambleatlas.com www.gambleatlas.com;

    root /var/www/gambleatlas/dist;
    index index.html;

    # /go/{slug} affiliate redirects — regenerated by
    # `npx tsx scripts/build-nginx-redirects.ts` on every deploy.
    include /var/www/gambleatlas/deploy/go-redirects.conf;

    # Astro's static build already emits /path/index.html for every route
    # (trailingSlash: 'always', build.format: 'directory').
    location / {
        try_files $uri $uri/index.html =404;
    }

    # No custom 404 page exists yet (src/pages/404.astro), so this falls back to
    # nginx's plain default. Add that page and an `error_page 404 /404.html;` line
    # here once it does.

    # Long cache for hashed build assets; everything else revalidates.
    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
