---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteIndexable } from '../lib/content';

interface Props {
  title: string;
  description: string;
  /** Page-level opt out, e.g. a facet still below the casino threshold. */
  noindex?: boolean;
  /** ISO date of the underlying data, not of the build. */
  dataModified?: string | null;
  /** Segments outbound-click events by where the click happened. */
  pageType?: 'home' | 'casino' | 'facet' | 'article' | 'static';
}

const {
  title,
  description,
  noindex = false,
  dataModified = null,
  pageType = 'static',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Site-wide off means keep crawlers out entirely. A page-level opt out still wants
// `follow`, so internal links stay discoverable and the page can promote itself later.
const robots = !siteIndexable
  ? 'noindex, nofollow'
  : noindex
    ? 'noindex, follow'
    : 'index, follow';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0E1114" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Casilla" />
    <meta name="twitter:card" content="summary_large_image" />
    {dataModified && <meta name="last-verified" content={dataModified} />}

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col" data-page-type={pageType}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-ink-700 focus:px-3 focus:py-2"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="flex-1 w-full max-w-[1120px] mx-auto px-4 py-10">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
