---
/**
 * Every tracker is optional and activates only when its ID is present in the
 * environment, so local and preview builds stay clean and a missing ID never breaks a
 * page. Nothing here is required for the site to function.
 */
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_ID;
const CF_BEACON = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

{
  GA4_ID && (
    <>
      {/*
        Consent Mode v2 defaults to denied before anything loads. Visitors arrive from
        the EU and the UK whether or not we target them, and defaulting to granted is
        the mistake that turns an analytics setup into a liability.
      */}
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500,
        });
      </script>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} />
      <script is:inline define:vars={{ GA4_ID }}>
        gtag('js', new Date());
        gtag('config', GA4_ID, { anonymize_ip: true });
      </script>
    </>
  )
}

{
  CLARITY_ID && (
    <script is:inline define:vars={{ CLARITY_ID }}>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', CLARITY_ID);
    </script>
  )
}

{
  CF_BEACON && (
    /* Server-side and cookieless, so it keeps counting when ad blockers remove GA4. */
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${CF_BEACON}"}`}
    />
  )
}

<script>
  // Behavioural events. Outbound clicks are also logged server-side in the /go/ Worker;
  // the gap between the two numbers is a useful read on how much ad blocking costs us.
  type Gtag = (...args: unknown[]) => void;
  const gtag = (window as unknown as { gtag?: Gtag }).gtag;

  function track(name: string, params: Record<string, unknown>) {
    gtag?.('event', name, params);
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-outbound]')) {
    link.addEventListener('click', () => {
      const card = link.closest('[data-casino]');
      const list = card?.closest('ol');
      const position = list
        ? [...list.querySelectorAll('[data-casino]')].indexOf(card!) + 1
        : null;

      track('outbound_click', {
        casino: link.dataset.outbound,
        page_type: document.body.dataset.pageType ?? 'unknown',
        position,
      });
    });
  }

  const search = document.getElementById('q') as HTMLInputElement | null;
  if (search) {
    let timer: number | undefined;
    search.addEventListener('input', () => {
      clearTimeout(timer);
      // Only the settled query is worth recording, not every keystroke.
      timer = window.setTimeout(() => {
        const term = search.value.trim();
        if (term.length >= 3) track('search_query', { term });
      }, 900);
    });
  }

  for (const control of document.querySelectorAll('[data-factor], [data-provider], #currency')) {
    control.addEventListener('change', () => {
      const factors = [...document.querySelectorAll<HTMLInputElement>('[data-factor]')]
        .filter((b) => b.checked)
        .map((b) => b.value);
      const providers = [...document.querySelectorAll<HTMLInputElement>('[data-provider]')]
        .filter((b) => b.checked)
        .map((b) => b.value);
      const coin = (document.getElementById('currency') as HTMLSelectElement | null)?.value;
      track('filter_apply', {
        factors: factors.join(',') || null,
        providers: providers.join(',') || null,
        coin: coin || null,
      });
    });
  }
</script>
