---
import CasinoLogo from './CasinoLogo.astro';
import CoinIcon from './CoinIcon.astro';
import { facetsForCasino } from '../lib/facets';
import { aggregateScore, lastVerified, normaliseSources, scoreBand } from '../lib/ratings';
import { MIN_RATING_SOURCES, type Casino } from '../lib/schemas';

interface Props {
  casino: Casino;
  rank: number;
}

const { casino, rank } = Astro.props;

const score = aggregateScore(casino);
const sources = normaliseSources(casino);
const verified = lastVerified(casino);
const factorChips = facetsForCasino(casino).filter((f) => f.kind === 'factor');

// "CODE:NETWORK" tokens so the network sub-filter can match a specific chain, not just
// the coin — e.g. "only casinos offering USDT on Tron," not any USDT support at all.
const networkTokens = casino.currencies.flatMap((c) =>
  c.networks.map((n) => `${c.code}:${n}`),
);
const shownCoins = casino.currencies.slice(0, 8);
const hiddenCoinCount = casino.currencies.length - shownCoins.length;

// Full class strings, because Tailwind cannot see dynamically assembled ones.
const bandClass = {
  high: 'text-score-high',
  mid: 'text-score-mid',
  low: 'text-score-low',
} as const;

const scoreClass = score === null ? 'text-ink-400' : bandClass[scoreBand(score)];

const verifiedLabel = verified
  ? new Date(`${verified}T00:00:00Z`).toLocaleDateString('en-GB', {
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : null;
---

<article
  class="surface surface-interactive relative flex items-start gap-4 p-4"
  data-casino
  data-name={casino.name.toLowerCase()}
  data-factors={casino.factors.join(',')}
  data-currencies={casino.currencies.map((c) => c.code).join(',')}
  data-networks={networkTokens.join(',')}
>
  <div class="tabular w-10 shrink-0 pt-1 text-right font-display text-[22px] font-bold text-ink-400">
    {rank}
  </div>

  <CasinoLogo slug={casino.slug} name={casino.name} size={48} />

  <div class="min-w-0 flex-1">
    <h3 class="text-[19px]">
      {/* Stretched link: the whole card is clickable, but the markup stays a real
          heading link, so screen readers and middle-click behave correctly. */}
      <a
        href={`/casinos/${casino.slug}/`}
        class="no-underline after:absolute after:inset-0 hover:text-amber-400"
        >{casino.name}</a
      >
    </h3>

    {
      sources.length > 0 && (
        <ul class="tabular mt-1.5 flex flex-wrap gap-x-3 gap-y-1 text-[13px] text-ink-300">
          {sources.map((s) => (
            <li>
              <abbr title={s.label} class="no-underline text-ink-400">
                {s.abbr}
              </abbr>{' '}
              <span class="text-ink-100">{s.raw}</span>
              <span class="text-ink-400">/{s.scale}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      shownCoins.length > 0 && (
        <ul class="mt-2 flex flex-wrap items-center gap-1" aria-label="Supported coins">
          {shownCoins.map((c) => (
            <li title={c.code}>
              <CoinIcon code={c.code} size={18} />
            </li>
          ))}
          {hiddenCoinCount > 0 && (
            <li class="text-[12px] text-ink-400">+{hiddenCoinCount}</li>
          )}
        </ul>
      )
    }

    {
      factorChips.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {factorChips.map((f) => (
            <li class="rounded-[3px] border border-ink-600 bg-ink-800 px-2 py-0.5 text-[13px] text-ink-300">
              {f.name}
            </li>
          ))}
        </ul>
      )
    }

    {
      casino.signupBonus && (
        <p class="mt-2.5 text-[15px] text-ink-100">
          <span class="text-ink-400">Sign-up bonus:</span> {casino.signupBonus.headline}
        </p>
      )
    }
  </div>

  <div class="flex shrink-0 flex-col items-end gap-2 pl-2">
    {
      score === null ? (
        <span class="text-[13px] text-ink-400" title={`Fewer than ${MIN_RATING_SOURCES} sources`}>
          Not rated
        </span>
      ) : (
        <span class={`tabular font-display text-[28px] font-bold leading-none ${scoreClass}`} data-score>
          {score.toFixed(1)}
        </span>
      )
    }

    <a
      href={`/go/${casino.slug}`}
      rel="sponsored nofollow noopener"
      target="_blank"
      data-outbound={casino.slug}
      class="relative z-10 rounded-[4px] bg-amber-500 px-3.5 py-2 text-[15px] font-semibold text-ink-900 no-underline hover:bg-amber-400"
      >Visit site</a
    >

    {verifiedLabel && <span class="text-[12px] text-ink-400">Verified {verifiedLabel}</span>}
  </div>
</article>
