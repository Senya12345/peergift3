---
import { COUNTRIES, countryName, type Country } from '../lib/countries';
import type { Casino } from '../lib/schemas';

/**
 * Answers one question — does this operator accept players from your country — and
 * refuses to answer the one it cannot.
 *
 * What this is not: a legality checker. An offshore licence regulates the operator, not
 * the player, and whether a resident of a given country may lawfully use an offshore
 * casino is that country's law rather than anything the licence establishes. Saying
 * "legal in your country" across 190 jurisdictions would be a legal opinion we cannot
 * verify, on a subject where being wrong causes real harm. So this reports the operator's
 * own restricted list and says plainly where its knowledge stops.
 *
 * The whole list is rendered as text as well as wired to the picker: a select that
 * computes its answer in JavaScript gives a crawler nothing, and the list of refused
 * countries is genuinely useful reading on its own.
 */
interface Props {
  casino: Casino;
}

const { casino } = Astro.props;
const { restrictions } = casino;

const restricted: Country[] = restrictions
  ? restrictions.countries
      .map((code) => ({ code, name: countryName(code) }))
      .sort((a, b) => a.name.localeCompare(b.name))
  : [];

const restrictedCodes = restrictions ? restrictions.countries.join(',') : '';
---

{
  restrictions === null ? (
    <p class="surface mt-4 max-w-[68ch] p-5 text-ink-300">
      We have not read {casino.name}'s restricted-country list yet, so we cannot tell you
      whether it accepts players where you live. Rather than guess, this section stays
      empty until someone has gone through the operator's terms and written the list down.
    </p>
  ) : (
    <>
      <p class="mt-3 max-w-[68ch] text-ink-300">
        {casino.name} refuses sign-ups from {restricted.length}{' '}
        {restricted.length === 1 ? 'country' : 'countries'} in its own terms. Pick yours to
        see whether you are on that list.
      </p>

      <div
        class="surface mt-4 max-w-[68ch] p-5"
        data-country-check
        data-restricted={restrictedCodes}
        data-casino-name={casino.name}
      >
        <label class="block">
          <span class="text-[14px] text-ink-300">Your country</span>
          <select
            data-country-select
            class="mt-1.5 w-full max-w-[320px] rounded-[4px] border border-ink-600 bg-ink-800 px-3 py-2.5 text-ink-050"
          >
            <option value="">Select a country…</option>
            {COUNTRIES.map((c) => (
              <option value={c.code}>{c.name}</option>
            ))}
          </select>
        </label>

        <p data-country-result class="mt-4 text-[15px] text-ink-400">
          Nothing selected yet.
        </p>

        <p class="mt-4 border-t border-ink-700 pt-3 text-[13px] text-ink-400">
          This is the operator's own list, not a legal opinion. Whether you may lawfully
          use an offshore casino is decided by the law where you live, not by{' '}
          {casino.name}'s licence — that licence authorises the operator, and gives you no
          regulator to complain to. We are not lawyers and this is not advice.
        </p>
      </div>

      {restricted.length > 0 && (
        <details class="surface mt-4 max-w-[68ch] p-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="cursor-pointer text-[15px] text-ink-100">
            All {restricted.length} countries {casino.name} refuses
          </summary>
          <p class="mt-3 text-[14px] leading-relaxed text-ink-300">
            {restricted.map((c) => c.name).join(' · ')}
          </p>
          <p class="mt-3 text-[13px] text-ink-400">
            Read from {restrictions.source}, checked{' '}
            <time datetime={restrictions.verifiedAt}>{restrictions.verifiedAt}</time>.
            Operators change these lists without notice.
          </p>
        </details>
      )}
    </>
  )
}

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-country-check]')) {
    const select = box.querySelector<HTMLSelectElement>('[data-country-select]')!;
    const result = box.querySelector<HTMLElement>('[data-country-result]')!;
    const restricted = new Set((box.dataset.restricted ?? '').split(',').filter(Boolean));
    const name = box.dataset.casinoName ?? 'This casino';

    const render = () => {
      const code = select.value;
      if (!code) {
        result.textContent = 'Nothing selected yet.';
        result.className = 'mt-4 text-[15px] text-ink-400';
        return;
      }
      const country = select.options[select.selectedIndex]!.text;
      if (restricted.has(code)) {
        result.textContent = `${name} does not accept players from ${country}. Signing up anyway risks the account being closed at the withdrawal stage rather than at registration, which is when a balance has already built up.`;
        result.className = 'mt-4 text-[15px] text-score-low';
      } else {
        result.textContent = `${country} is not on ${name}'s refused list. That means the operator will take your sign-up — it does not mean playing is lawful where you are.`;
        result.className = 'mt-4 text-[15px] text-ink-100';
      }
    };

    // Preselect from the browser's own locale rather than an IP lookup: no third-party
    // request, nothing for an ad blocker to strip, and no address leaving the page. It is
    // a hint and often wrong, so it only moves the picker — the reader still chooses.
    const region = new Intl.Locale(navigator.language).region;
    if (region && [...select.options].some((o) => o.value === region)) {
      select.value = region;
    }

    select.addEventListener('change', render);
    render();
  }
</script>
