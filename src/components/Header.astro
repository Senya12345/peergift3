---
import { Image } from 'astro:assets';
import lockup from '../assets/brand/lockup.png';
import { loadSlots } from '../lib/content';

/**
 * Slots only join the navigation once there are slots. A permanent link to an empty
 * section is a dead end for readers and a thin page for crawlers; this way the header
 * matches the intended layout the moment the first slot record lands, without shipping a
 * link to nothing in the meantime.
 */
const hasSlots = loadSlots().length > 0;

const links = [
  ...(hasSlots ? [{ href: '/slots/', label: 'Slots' }] : []),
  { href: '/providers/', label: 'Providers' },
  { href: '/articles/', label: 'Articles' },
];

const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current.startsWith(href);
---

<header class="border-b border-ink-600 bg-ink-800">
  <div class="mx-auto flex h-16 max-w-[1120px] items-center gap-3 px-4">
    <a href="/" class="group flex items-center gap-2.5 no-underline">
      {/* width/height are the CSS size, and `densities` emits the 2x and 3x rasters
          alongside so the browser takes the one its screen needs. The mark is a drawing
          with hairline rigging and a course made of dots — at 34px those are one or two
          pixels each, so a 3x phone served a 2x file turns both to mush. The whole
          density ladder costs about 5 KB more than the 2x file alone, which is not a
          budget worth defending. Quality is near-lossless for the same reason: the art is
          two flat colours, where WebP's lossy mode spends its savings on ringing around
          every edge. */}
      <Image
        src={lockup}
        alt=""
        aria-hidden="true"
        width={48}
        height={34}
        densities={[1, 2, 3]}
        format="webp"
        quality={100}
        loading="eager"
        class="h-[34px] w-auto shrink-0"
      />
      <span
        class="font-display text-[19px] font-bold tracking-tight text-ink-050 group-hover:text-amber-400"
        >Gamble Atlas</span
      >
    </a>

    <nav class="ml-auto hidden sm:block" aria-label="Main">
      <ul class="flex items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class="px-2.5 py-1 text-[15px] no-underline aria-[current=page]:text-amber-400 text-ink-300 hover:text-ink-050"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="ml-auto flex h-9 w-9 items-center justify-center rounded-[4px] text-ink-200 hover:bg-ink-700 hover:text-ink-050 sm:hidden"
    >
      <span class="sr-only">Open menu</span>
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <path
          d="M3 5.5h14M3 10h14M3 14.5h14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile drawer. Hidden from the accessibility tree while closed, so a screen reader
     does not read the navigation twice on a phone. -->
<div id="mobile-menu" hidden class="sm:hidden">
  <div id="menu-backdrop" class="fixed inset-0 z-40 bg-black/60"></div>
  <nav
    aria-label="Main"
    class="fixed right-0 top-0 z-50 h-full w-[264px] max-w-[80vw] border-l border-ink-600 bg-ink-800 p-5"
  >
    <button
      type="button"
      id="menu-close"
      class="mb-6 flex h-9 w-9 items-center justify-center rounded-[4px] text-ink-200 hover:bg-ink-700 hover:text-ink-050"
    >
      <span class="sr-only">Close menu</span>
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <path
          d="M5 5l10 10M15 5L5 15"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <ul class="space-y-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class="block rounded-[4px] px-3 py-2.5 text-[17px] no-underline aria-[current=page]:text-amber-400 text-ink-200 hover:bg-ink-700 hover:text-ink-050"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('menu-close');
  const backdrop = document.getElementById('menu-backdrop');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      // Stops the page scrolling behind the drawer on iOS.
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
      else toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(menu.hidden));
    closeBtn?.addEventListener('click', () => setOpen(false));
    backdrop?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false);
    });
  }
</script>
