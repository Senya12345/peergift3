---
import { Image } from 'astro:assets';
import { providerLogo } from '../lib/provider-logos';

interface Props {
  slug: string;
  name: string;
  /** Games catalogued from this studio, shown under the mark when given. Omitted rather
   * than shown as 0 — a studio with no slots recorded yet isn't "0 games", it's not
   * checked, and the two read very differently under a logo. */
  slotCount?: number;
}

const { slug, name, slotCount } = Astro.props;
const logo = providerLogo(slug);
---

<span class="flex flex-col items-center gap-1">
  {
    /*
      The fetched marks are mostly light artwork drawn for a dark casino lobby, and the
      fetch script strips the flat backdrop they ship with, so they sit directly on the tile
      with no white plate behind them — unlike the casino logos, which arrive in every
      colour and need one. A studio whose logo has not been fetched yet falls back to its
      name, which is also the only thing a screen reader ever gets either way.
    */
    logo ? (
      <Image
        src={logo}
        alt={`${name} logo`}
        width={169}
        height={67}
        loading="lazy"
        class="max-h-full max-w-full object-contain"
      />
    ) : (
      <span class="px-2 text-center text-[13px] font-semibold leading-tight text-ink-300">
        {name}
      </span>
    )
  }
  {
    !!slotCount && (
      <span class="tabular text-[12px] text-ink-400">
        {slotCount.toLocaleString('en-US')} {slotCount === 1 ? 'game' : 'games'}
      </span>
    )
  }
</span>
