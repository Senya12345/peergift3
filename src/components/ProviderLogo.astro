---
import { Image } from 'astro:assets';
import { providerLogo } from '../lib/provider-logos';

interface Props {
  slug: string;
  name: string;
}

const { slug, name } = Astro.props;
const logo = providerLogo(slug);
---

{
  /*
    The fetched marks are mostly light artwork drawn for a dark casino lobby, and the
    fetch script strips the flat backdrop they ship with, so they sit directly on the tile
    with no white plate behind them — unlike the casino logos, which arrive in every
    colour and need one. A studio whose logo has not been fetched yet falls back to its
    name, which is also the only thing a screen reader ever gets either way.
  */
  logo ? (
    <Image
      src={logo}
      alt={`${name} logo`}
      width={169}
      height={67}
      loading="lazy"
      class="max-h-full max-w-full object-contain"
    />
  ) : (
    <span class="px-2 text-center text-[13px] font-semibold leading-tight text-ink-300">
      {name}
    </span>
  )
}
