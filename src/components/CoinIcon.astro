---
import { coinIconSvg } from '../lib/coin-icons';

interface Props {
  code: string;
  /** Pixel size, square. */
  size?: number;
}

const { code, size = 20 } = Astro.props;
const svg = coinIconSvg(code);

// A small set of coins (BUSD, CRO, SHIB, TRUMP as of writing) have no CC0 icon
// available from the source we use. Rather than a broken image, they get a flat
// monogram badge in the site's own palette — it never looks unfinished.
const monogram = code.slice(0, 3).toUpperCase();
---

{
  svg ? (
    <span
      class="inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full"
      style={`width:${size}px;height:${size}px`}
      set:html={svg}
      aria-hidden="true"
    />
  ) : (
    <span
      class="inline-flex shrink-0 items-center justify-center rounded-full bg-ink-600 font-display font-bold text-ink-100"
      style={`width:${size}px;height:${size}px;font-size:${Math.max(7, size * 0.32)}px`}
      aria-hidden="true"
    >
      {monogram}
    </span>
  )
}
