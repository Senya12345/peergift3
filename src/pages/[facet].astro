---
import CasinoCard from '../components/CasinoCard.astro';
import Base from '../layouts/Base.astro';
import { RESERVED_SLUGS } from '../lib/content';
import { getFacets, relatedFacets, type Facet } from '../lib/facets';
import { lastVerified } from '../lib/ratings';
import { FACET_MIN_CASINOS } from '../lib/schemas';

export function getStaticPaths() {
  const facets = getFacets();

  // Facet slugs live at the root for maximum SEO weight, which means a collision with a
  // real route would silently shadow it. Fail the build instead.
  const seen = new Set<string>();
  for (const f of facets) {
    if (RESERVED_SLUGS.has(f.slug)) {
      throw new Error(`Facet slug "${f.slug}" collides with a reserved route.`);
    }
    if (seen.has(f.slug)) {
      throw new Error(`Duplicate facet slug "${f.slug}".`);
    }
    seen.add(f.slug);
  }

  return facets.map((facet) => ({ params: { facet: facet.slug }, props: { facet } }));
}

interface Props {
  facet: Facet;
}

const { facet } = Astro.props;
const related = relatedFacets(facet);

const dataModified = facet.casinos
  .map((c) => lastVerified(c))
  .filter((d): d is string => d !== null)
  .sort()
  .at(-1) ?? null;
---

<Base
  title={facet.metaTitle}
  description={facet.metaDescription}
  noindex={!facet.indexable}
  dataModified={dataModified}
>
  <nav aria-label="Breadcrumb" class="text-[14px] text-ink-400">
    <a href="/" class="hover:text-ink-100">Ranking</a>
    <span aria-hidden="true"> / </span>
    <span class="text-ink-300">{facet.name}</span>
  </nav>

  <h1 class="mt-4 max-w-[24ch] text-[32px] sm:text-[38px]">{facet.h1}</h1>

  <div class="mt-5 max-w-[68ch] space-y-4 text-ink-100">
    {facet.intro.split('\n\n').map((p) => <p>{p}</p>)}
  </div>

  <section class="mt-10" aria-label="Matching casinos">
    <h2 class="text-[24px]">
      {facet.casinos.length}{facet.casinos.length === 1 ? ' casino' : ' casinos'} match
    </h2>

    {
      facet.casinos.length === 0 ? (
        <p class="surface mt-4 p-6 text-ink-300">
          Nothing here yet. This page fills in as casinos with this feature are added.
        </p>
      ) : (
        <ol class="mt-4 space-y-2.5">
          {facet.casinos.map((casino, i) => (
            <li>
              <CasinoCard casino={casino} rank={i + 1} />
            </li>
          ))}
        </ol>
      )
    }
  </section>

  {
    facet.faq.length > 0 && (
      <section class="mt-10">
        <h2 class="text-[24px]">Common questions</h2>
        <dl class="mt-4 max-w-[68ch] space-y-5">
          {facet.faq.map((item) => (
            <div>
              <dt class="font-display text-[18px] font-bold text-ink-050">{item.q}</dt>
              <dd class="mt-1.5 text-ink-100">{item.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="mt-10">
        <h2 class="text-[24px]">Related lists</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {related.map((f) => (
            <li>
              <a
                href={`/${f.slug}/`}
                class="inline-block rounded-[3px] border border-ink-600 bg-ink-800 px-2.5 py-1 text-[14px] text-ink-100 no-underline hover:border-ink-400 hover:text-amber-400"
              >
                {f.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    !facet.indexable && (
      <p class="mt-10 text-[13px] text-ink-400">
        This list holds fewer than {FACET_MIN_CASINOS} casinos, so it is kept out of search
        results until it offers a real choice.
      </p>
    )
  }
</Base>
