---
import CasinoCard from '../components/CasinoCard.astro';
import CoinIcon from '../components/CoinIcon.astro';
import JsonLd from '../components/JsonLd.astro';
import Base from '../layouts/Base.astro';
import { loadCasinos, loadCurrencies, loadFactors } from '../lib/content';
import { byScoreDesc, lastVerified } from '../lib/ratings';
import { casinoList, organization, website } from '../lib/schema';
import { SITE } from '../lib/site';

const casinos = [...loadCasinos()].sort(byScoreDesc);
const factors = loadFactors();

// Software/game providers across all listed casinos, alphabetised for the filter list —
// there's no popularity ordering worth encoding here the way there is for coins.
const providers = [...new Set(casinos.flatMap((c) => c.providers))].sort((a, b) =>
  a.localeCompare(b),
);

const dataModified = casinos
  .map((c) => lastVerified(c))
  .filter((d): d is string => d !== null)
  .sort()
  .at(-1) ?? null;

// Rough descending order by real-world usage in crypto casinos, so the most-reached-for
// coins sit first wherever coins are listed — not the alphabetical order loadCurrencies()
// returns, which floats whichever ticker starts with "A" to the top regardless of whether
// anyone has heard of it.
const POPULARITY: readonly string[] = [
  'BTC', 'ETH', 'USDT', 'USDC', 'BNB', 'SOL', 'XRP', 'TRX', 'LTC', 'DOGE',
  'ADA', 'TON', 'BCH', 'LINK', 'AVAX', 'DAI', 'SHIB', 'UNI', 'EOS', 'HBAR',
  'CRO', 'POL', 'BUSD', 'SAND', 'APE', 'TRUMP',
];
const byPopularity = <T extends { code: string }>(list: T[]): T[] =>
  [...list].sort((a, b) => {
    const ia = POPULARITY.indexOf(a.code);
    const ib = POPULARITY.indexOf(b.code);
    return (ia === -1 ? POPULARITY.length : ia) - (ib === -1 ? POPULARITY.length : ib);
  });

const currencies = byPopularity(loadCurrencies());

// Coins actually offered by at least one listed casino, for the "supported coins"
// strip beneath the intro. Shown even before any coin is indexable on its own facet
// page — the union itself is useful information regardless of individual page status.
const supportedCoinCodes = [
  ...new Set(casinos.flatMap((c) => c.currencies.map((s) => s.code))),
];
const supportedCoins = byPopularity(
  currencies.filter((c) => supportedCoinCodes.includes(c.code)),
);
---

<Base
  title={`${SITE.name} — Crypto Casino Ratings From Every Major Review Site`}
  description="One combined score per crypto casino, built from the published ratings of AskGamblers, Casino Guru, Trustpilot and others. Every figure is linked back to its source."
  dataModified={dataModified}
  pageType="home"
>
  <JsonLd
    slot="head"
    data={[
      { '@context': 'https://schema.org', ...organization() },
      website(),
      casinos.length > 0 ? casinoList(casinos) : null,
    ]}
  />

  <h1 class="text-[34px] sm:text-[40px] max-w-[20ch]">Crypto gambling ratings aggregator</h1>

  <p class="mt-4 max-w-[62ch] text-ink-300">
    Every score below is the average of what several independent review platforms
    published about that casino, rebased onto one scale. We show the individual figures
    and link to each one, so you can check the number rather than trust it.
  </p>

  {
    supportedCoins.length > 0 && (
      <ul class="mt-5 flex flex-wrap items-center gap-2.5" aria-label="Coins supported across our casinos">
        {supportedCoins.map((c) => (
          <li>
            <a
              href={`/${c.facetSlug}/`}
              title={`${c.name} (${c.code})`}
              class="flex items-center gap-1.5 rounded-[3px] border border-ink-600 bg-ink-800 px-2 py-1 text-[13px] text-ink-300 no-underline hover:border-ink-400 hover:text-ink-050"
            >
              <CoinIcon code={c.code} size={16} />
              {c.code}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-8 grid gap-8 lg:grid-cols-[268px_1fr] lg:items-start">
    <!-- Search and filters -->
    <aside aria-label="Search and filter" class="lg:sticky lg:top-6">
      <label class="block">
        <span class="sr-only">Search casinos by name</span>
        <input
          type="search"
          id="q"
          placeholder="Search casinos"
          autocomplete="off"
          class="w-full rounded-[4px] border border-ink-600 bg-ink-800 px-3 py-2.5 text-ink-050 placeholder:text-ink-400"
        />
      </label>

      <button
        type="button"
        id="filters-toggle"
        aria-expanded="false"
        aria-controls="filters-panel"
        class="mt-3 flex w-full items-center justify-between rounded-[4px] border border-ink-600 bg-ink-800 px-3 py-2.5 text-[14px] text-ink-100 lg:hidden"
      >
        Filters
        <svg
          width="11"
          height="11"
          viewBox="0 0 12 12"
          class="shrink-0 transition-transform duration-150"
          data-toggle-chevron
        >
          <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div id="filters-panel" class="hidden space-y-6 lg:mt-4 lg:block" data-filters-panel>
        <fieldset class="mt-4 min-w-0 lg:mt-0">
          <legend class="mb-1.5 text-[14px] text-ink-300">
            Deposit and withdrawal coin — select any number
          </legend>
          <div class="max-h-64 space-y-0.5 overflow-y-auto rounded-[4px] border border-ink-600 bg-ink-800 p-2">
            {
              currencies.map((c) => (
                <div data-coin-row={c.code}>
                  <div class="flex items-center gap-1.5">
                    <label class="flex flex-1 cursor-pointer items-center gap-2 py-1 text-[14px] hover:text-ink-050">
                      <input type="checkbox" class="checkbox" data-coin value={c.code} />
                      <CoinIcon code={c.code} size={16} />
                      {c.name}
                      <span class="text-ink-400">{c.code}</span>
                    </label>
                    {c.networks.length > 0 && (
                      <button
                        type="button"
                        data-expand={c.code}
                        aria-expanded="false"
                        class="shrink-0 rounded-[3px] px-1.5 py-1 text-ink-400 hover:bg-ink-700 hover:text-ink-050"
                        title="Choose a network"
                      >
                        <svg
                          width="11"
                          height="11"
                          viewBox="0 0 12 12"
                          class="transition-transform duration-150 data-[open=true]:rotate-90"
                          data-chevron
                        >
                          <path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </button>
                    )}
                  </div>
                  {c.networks.length > 0 && (
                    <div data-networks-for={c.code} hidden class="ml-7 mb-1 flex flex-wrap gap-x-3 gap-y-1 border-l border-ink-600 pl-3">
                      {c.networks.map((n) => (
                        <label class="flex cursor-pointer items-center gap-1.5 py-0.5 text-[13px] text-ink-300 hover:text-ink-050">
                          <input type="checkbox" class="checkbox" data-network value={`${c.code}:${n.code}`} />
                          {n.name}
                        </label>
                      ))}
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </fieldset>

        {
          factors.length > 0 && (
            <fieldset class="min-w-0">
              <legend class="mb-1.5 text-[14px] text-ink-300">Features — select any number</legend>
              <div class="flex flex-wrap gap-x-4 gap-y-2 lg:flex-col lg:gap-y-1.5">
                {factors.map((f) => (
                  <label class="flex cursor-pointer items-center gap-2 text-[15px] hover:text-ink-050">
                    <input type="checkbox" class="checkbox" data-factor value={f.slug} />
                    {f.name}
                  </label>
                ))}
              </div>
            </fieldset>
          )
        }

        {
          providers.length > 0 && (
            <fieldset class="min-w-0">
              <legend class="mb-1.5 text-[14px] text-ink-300">Software providers — select any number</legend>
              <div class="max-h-64 space-y-0.5 overflow-y-auto rounded-[4px] border border-ink-600 bg-ink-800 p-2">
                {providers.map((p) => (
                  <label class="flex cursor-pointer items-center gap-2 py-1 text-[14px] hover:text-ink-050">
                    <input type="checkbox" class="checkbox" data-provider value={p} />
                    {p}
                  </label>
                ))}
              </div>
            </fieldset>
          )
        }
      </div>
    </aside>

    <!-- Ranking -->
    <section aria-label="Casino ranking">
      <p class="mb-3 text-[14px] text-ink-400" id="count" aria-live="polite">
        {casinos.length}{casinos.length === 1 ? ' casino' : ' casinos'}
      </p>

      {
        casinos.length === 0 ? (
          <p class="surface p-6 text-ink-300">
            No casinos have been published yet. The ranking appears here as they are added.
          </p>
        ) : (
          <ol class="space-y-2.5" id="list">
            {casinos.map((casino, i) => (
              <li>
                <CasinoCard casino={casino} rank={i + 1} />
              </li>
            ))}
          </ol>
        )
      }

      <p id="empty" hidden class="surface p-6 text-ink-300">
        No casino matches those filters. Try clearing a coin, network or feature.
      </p>
    </section>
  </div>
</Base>

<script>
  // Filtering is client-side over markup that already contains every casino, so the
  // crawler sees the full list and the interaction costs no request. The URL is kept in
  // sync for shareability, but combinations are deliberately not indexable — the
  // canonical home for a single feature is its own facet page.
  const list = document.getElementById('list');
  if (list) {
    const cards = [...list.querySelectorAll<HTMLElement>('[data-casino]')];
    const items = cards.map((card) => ({
      card,
      li: card.closest('li') as HTMLElement,
      name: card.dataset.name ?? '',
      factors: (card.dataset.factors ?? '').split(',').filter(Boolean),
      currencies: (card.dataset.currencies ?? '').split(',').filter(Boolean),
      networks: (card.dataset.networks ?? '').split(',').filter(Boolean),
      providers: (card.dataset.providers ?? '').split(',').filter(Boolean),
    }));

    const q = document.getElementById('q') as HTMLInputElement;
    const coinBoxes = [...document.querySelectorAll<HTMLInputElement>('[data-coin]')];
    const networkBoxes = [...document.querySelectorAll<HTMLInputElement>('[data-network]')];
    const factorBoxes = [...document.querySelectorAll<HTMLInputElement>('[data-factor]')];
    const providerBoxes = [...document.querySelectorAll<HTMLInputElement>('[data-provider]')];
    const count = document.getElementById('count')!;
    const empty = document.getElementById('empty')!;

    // Mobile-only collapse: the panel is always visible at the lg breakpoint regardless
    // of this toggle (see the "hidden lg:block" pairing on the panel itself).
    const filtersToggle = document.getElementById('filters-toggle');
    const filtersPanel = document.querySelector<HTMLElement>('[data-filters-panel]');
    filtersToggle?.addEventListener('click', () => {
      const open = filtersToggle.getAttribute('aria-expanded') === 'true';
      filtersToggle.setAttribute('aria-expanded', String(!open));
      filtersPanel?.classList.toggle('hidden', open);
      filtersToggle.querySelector('[data-toggle-chevron]')?.setAttribute('data-open', String(!open));
    });

    // Expand/collapse per-coin network lists.
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-expand]')) {
      const code = btn.dataset.expand!;
      const panel = document.querySelector<HTMLElement>(`[data-networks-for="${code}"]`);
      const chevron = btn.querySelector('[data-chevron]');
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        chevron?.setAttribute('data-open', String(!open));
        if (panel) panel.hidden = open;
      });
    }

    // Effective coin/network criteria: a network checked under a coin takes priority
    // over that coin's own box, since checking a network is a more specific request.
    function selectedCriteria(): { coins: Set<string>; networks: Set<string> } {
      const networks = new Set(networkBoxes.filter((b) => b.checked).map((b) => b.value));
      const coinsWithNetworkChoice = new Set(
        [...networks].map((token) => token.split(':')[0]),
      );
      const coins = new Set(
        coinBoxes
          .filter((b) => b.checked && !coinsWithNetworkChoice.has(b.value))
          .map((b) => b.value),
      );
      return { coins, networks };
    }

    function apply() {
      const term = q.value.trim().toLowerCase();
      const { coins, networks } = selectedCriteria();
      const wantedFactors = factorBoxes.filter((b) => b.checked).map((b) => b.value);
      const wantedProviders = providerBoxes.filter((b) => b.checked).map((b) => b.value);

      let shown = 0;
      for (const item of items) {
        const matchesCoin =
          coins.size === 0 && networks.size === 0
            ? true
            : [...coins].some((c) => item.currencies.includes(c)) ||
              [...networks].some((n) => item.networks.includes(n));

        const ok =
          (!term || item.name.includes(term)) &&
          matchesCoin &&
          wantedFactors.every((f) => item.factors.includes(f)) &&
          wantedProviders.every((p) => item.providers.includes(p));
        item.li.hidden = !ok;
        if (ok) shown++;
      }

      // Ranks reflect what is on screen, so the numbering never skips.
      let rank = 0;
      for (const item of items) {
        if (item.li.hidden) continue;
        rank++;
        const cell = item.card.firstElementChild;
        if (cell) cell.textContent = String(rank);
      }

      count.textContent = `${shown}${shown === 1 ? ' casino' : ' casinos'}`;
      empty.hidden = shown > 0;

      const params = new URLSearchParams();
      if (coins.size) params.set('coin', [...coins].join(','));
      if (networks.size) params.set('net', [...networks].join(','));
      if (wantedFactors.length) params.set('f', wantedFactors.join(','));
      if (wantedProviders.length) params.set('p', wantedProviders.join(','));
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    // Restore state from a shared URL.
    const initial = new URLSearchParams(location.search);
    const coins0 = (initial.get('coin') ?? '').split(',').filter(Boolean);
    for (const b of coinBoxes) b.checked = coins0.includes(b.value);
    const nets0 = (initial.get('net') ?? '').split(',').filter(Boolean);
    for (const b of networkBoxes) {
      b.checked = nets0.includes(b.value);
      if (b.checked) {
        const code = b.value.split(':')[0];
        const panel = document.querySelector<HTMLElement>(`[data-networks-for="${code}"]`);
        const btn = document.querySelector<HTMLButtonElement>(`[data-expand="${code}"]`);
        if (panel) panel.hidden = false;
        btn?.setAttribute('aria-expanded', 'true');
      }
    }
    const f0 = (initial.get('f') ?? '').split(',').filter(Boolean);
    for (const b of factorBoxes) b.checked = f0.includes(b.value);
    const p0 = (initial.get('p') ?? '').split(',').filter(Boolean);
    for (const b of providerBoxes) b.checked = p0.includes(b.value);
    if (coins0.length || nets0.length || f0.length || p0.length) {
      filtersToggle?.setAttribute('aria-expanded', 'true');
      filtersPanel?.classList.remove('hidden');
    }

    apply();

    q.addEventListener('input', apply);
    for (const b of coinBoxes) b.addEventListener('change', apply);
    for (const b of networkBoxes) b.addEventListener('change', apply);
    for (const b of factorBoxes) b.addEventListener('change', apply);
    for (const b of providerBoxes) b.addEventListener('change', apply);
  }
</script>
