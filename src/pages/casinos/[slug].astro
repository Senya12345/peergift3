---
import CasinoLogo from '../../components/CasinoLogo.astro';
import CoinIcon from '../../components/CoinIcon.astro';
import JsonLd from '../../components/JsonLd.astro';
import PageNav from '../../components/PageNav.astro';
import RatingTable from '../../components/RatingTable.astro';
import Base from '../../layouts/Base.astro';
import { breadcrumbs, casinoReview, faqPage } from '../../lib/schema';
import { loadCasinos } from '../../lib/content';
import { facetsForCasino } from '../../lib/facets';
import { aggregateScore, lastVerified, normaliseSources, scoreBand } from '../../lib/ratings';
import { MIN_RATING_SOURCES, type Casino } from '../../lib/schemas';
import { SITE } from '../../lib/site';

export function getStaticPaths() {
  return loadCasinos().map((casino) => ({
    params: { slug: casino.slug },
    props: { casino },
  }));
}

interface Props {
  casino: Casino;
}

const { casino } = Astro.props;

const score = aggregateScore(casino);
const sources = normaliseSources(casino);
const verified = lastVerified(casino);
const facets = facetsForCasino(casino);
const factorFacets = facets.filter((f) => f.kind === 'factor');
const currencyFacets = facets.filter((f) => f.kind === 'currency');

const bandClass = {
  high: 'text-score-high',
  mid: 'text-score-mid',
  low: 'text-score-low',
} as const;
const scoreClass = score === null ? 'text-ink-400' : bandClass[scoreBand(score)];

const description =
  score === null
    ? `${casino.name}: what we could and could not verify, the bonus terms, and where to read player reviews.`
    : `${casino.name} scores ${score.toFixed(1)}/10 across ${sources.length} review platforms. Bonus terms, payout behaviour and what players complain about.`;

/**
 * The page's own table of contents, and the source of every section's id and heading.
 *
 * Not every casino has every section — a record with one rating source shows no breakdown,
 * Polymarket has no coins table — so the list is assembled from what this record actually
 * carries. Deriving the jump links and the headings from the same array is what stops a
 * link pointing at a section that was not rendered.
 */
const sections = [
  sources.length > 0 && {
    id: 'ratings',
    label: 'Ratings',
    heading: 'Where the score comes from',
  },
  { id: 'verdict', label: 'Our take', heading: 'Our take' },
  casino.faq.length > 0 && {
    id: 'faq',
    label: 'FAQ',
    heading: `${casino.name} questions, answered`,
  },
  casino.currencies.length > 0 && {
    id: 'coins',
    label: 'Coins',
    heading: 'Supported coins',
  },
  (factorFacets.length > 0 || currencyFacets.length > 0) && {
    id: 'features',
    label: 'Features',
    heading: 'Features and coins',
  },
  casino.aiSummary && { id: 'ai-summary', label: 'AI summary', heading: 'AI summary' },
  (casino.license || casino.founded) && {
    id: 'operator',
    label: 'Operator',
    heading: 'Operator details',
  },
].filter((s): s is { id: string; label: string; heading: string } => Boolean(s));

const heading = (id: string) => sections.find((s) => s.id === id)!.heading;
---

<Base
  title={`${casino.name} Review: Ratings, Bonus and Payouts — ${SITE.name}`}
  description={description}
  dataModified={verified}
  pageType="casino"
>
  <JsonLd
    slot="head"
    data={[
      casinoReview(casino),
      faqPage(casino.faq),
      breadcrumbs([
        { name: 'Ranking', path: '/' },
        { name: casino.name, path: `/casinos/${casino.slug}/` },
      ]),
    ]}
  />

  <nav aria-label="Breadcrumb" class="text-[14px] text-ink-400">
    <a href="/" class="hover:text-ink-100">Ranking</a>
    <span aria-hidden="true"> / </span>
    <span class="text-ink-300">{casino.name}</span>
  </nav>

  <div class="mt-5 flex flex-wrap items-start gap-5">
    <CasinoLogo slug={casino.slug} name={casino.name} size={64} />

    <div class="min-w-0 flex-1">
      <h1 class="text-[32px] sm:text-[38px]">{casino.name}</h1>
      {
        verified && (
          <p class="mt-1 text-[14px] text-ink-400">
            Last verified <time datetime={verified}>{verified}</time>
          </p>
        )
      }
    </div>

    <div class="flex flex-col items-end gap-2">
      {
        score === null ? (
          <span class="text-[15px] text-ink-400">
            Not rated — fewer than {MIN_RATING_SOURCES} sources
          </span>
        ) : (
          <span class={`tabular font-display text-[44px] font-bold leading-none ${scoreClass}`}>
            {score.toFixed(1)}
          </span>
        )
      }
      <a
        href={`/go/${casino.slug}`}
        rel="sponsored nofollow noopener"
        target="_blank"
        data-outbound={casino.slug}
        class="rounded-[4px] bg-amber-500 px-4 py-2.5 font-semibold text-ink-900 no-underline hover:bg-amber-400"
        >Visit site</a
      >
    </div>
  </div>

  {/* Above the bonus block on purpose: the bonus detail runs long, and a reader who
      arrived from "is X legit" should not have to scroll past the terms and conditions to
      find the jump link that answers them. */}
  <PageNav sections={sections} />

  {
    casino.signupBonus && (
      <div class="surface mt-6 p-4">
        <p class="text-[17px]">
          <span class="text-ink-400">Sign-up bonus:</span>{' '}
          <span class="text-ink-050">{casino.signupBonus.headline}</span>
        </p>
        {casino.signupBonus.detail && (
          <p class="mt-1.5 text-[15px] text-ink-300">{casino.signupBonus.detail}</p>
        )}
      </div>
    )
  }

  {
    sources.length > 0 && (
      <section class="mt-10">
        <h2 id="ratings" class="text-[24px]">{heading('ratings')}</h2>
        <div class="mt-4">
          <RatingTable sources={sources} />
        </div>
        {score !== null && (
          <p class="mt-3 text-[14px] text-ink-400">
            Our figure is the mean of the {sources.length} normalised scores above. Nothing
            is weighted and nothing is adjusted — see{' '}
            <a href="/methodology/">how we rate</a>.
          </p>
        )}
      </section>
    )
  }

  <section class="mt-10">
    <h2 id="verdict" class="text-[24px]">{heading('verdict')}</h2>
    <div class="mt-3 max-w-[68ch] space-y-4 text-ink-100">
      {casino.editorial.summary.split('\n\n').map((p) => <p>{p}</p>)}
    </div>

    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      <div>
        <h3 class="text-[18px]">What works</h3>
        <ul class="mt-2 space-y-1.5 text-ink-100">
          {casino.editorial.pros.map((p) => <li class="pl-4 -indent-4">— {p}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="text-[18px]">What to watch</h3>
        <ul class="mt-2 space-y-1.5 text-ink-100">
          {casino.editorial.cons.map((c) => <li class="pl-4 -indent-4">— {c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {
    casino.faq.length > 0 && (
      <section class="mt-10">
        <h2 id="faq" class="text-[24px]">{heading('faq')}</h2>
        <p class="mt-2 max-w-[68ch] text-[14px] text-ink-400">
          Short answers to what people search for about this casino. Each one restates what
          is documented elsewhere on this page rather than adding anything new.
        </p>
        <div class="mt-5 max-w-[72ch] space-y-4">
          {casino.faq.map((item) => (
            <details class="surface group p-4 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-start justify-between gap-4 font-display text-[17px] font-bold text-ink-050">
                {item.q}
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                  class="mt-1 shrink-0 text-ink-400 transition-transform group-open:rotate-45"
                >
                  <path
                    d="M10 4v12M4 10h12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                </svg>
              </summary>
              <p class="mt-3 text-ink-100">{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )
  }

  {
    casino.currencies.length > 0 && (
      <section class="mt-10">
        <h2 id="coins" class="text-[24px]">{heading('coins')}</h2>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[360px] border-collapse text-[15px]">
            <thead>
              <tr class="border-b border-ink-600 text-left text-[14px] text-ink-300">
                <th scope="col" class="py-2 pr-4">Coin</th>
                <th scope="col" class="py-2">Networks</th>
              </tr>
            </thead>
            <tbody>
              {casino.currencies.map((c) => (
                <tr class="border-b border-ink-600/60">
                  <th scope="row" class="flex items-center gap-2 py-2.5 pr-4 text-left font-normal text-ink-050">
                    <CoinIcon code={c.code} size={18} />
                    {c.code}
                  </th>
                  <td class="py-2.5 text-ink-300">
                    {c.networks.length > 0 ? c.networks.join(', ') : 'native chain only'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    (factorFacets.length > 0 || currencyFacets.length > 0) && (
      <section class="mt-10">
        <h2 id="features" class="text-[24px]">{heading('features')}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {[...factorFacets, ...currencyFacets].map((f) => (
            <li>
              <a
                href={`/${f.slug}/`}
                class="inline-block rounded-[3px] border border-ink-600 bg-ink-800 px-2.5 py-1 text-[14px] text-ink-100 no-underline hover:border-ink-400 hover:text-amber-400"
              >
                {f.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    casino.aiSummary && (
      <section class="mt-10">
        <div class="mb-3 flex items-center gap-2">
          <h2 id="ai-summary" class="text-[24px]">{heading('ai-summary')}</h2>
          <span class="rounded-[3px] border border-amber-500/40 bg-amber-950 px-1.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-amber-400">
            AI-generated
          </span>
        </div>
        <p class="max-w-[68ch] text-[14px] text-ink-400">
          A synthesis of what public reviews say, not a first-hand test. It sits apart
          from our own editorial verdict above on purpose — see{' '}
          <a href="/methodology/">how we rate</a> for why the two are kept separate.
        </p>
        <dl class="mt-4 max-w-[68ch] space-y-5">
          <div>
            <dt class="font-display text-[16px] font-bold text-ink-050">Withdrawals</dt>
            <dd class="mt-1 text-ink-100">{casino.aiSummary.withdrawals}</dd>
          </div>
          <div>
            <dt class="font-display text-[16px] font-bold text-ink-050">Deposits</dt>
            <dd class="mt-1 text-ink-100">{casino.aiSummary.deposits}</dd>
          </div>
          <div>
            <dt class="font-display text-[16px] font-bold text-ink-050">Common problems</dt>
            <dd class="mt-1 text-ink-100">{casino.aiSummary.commonProblems}</dd>
          </div>
        </dl>
        <p class="mt-3 text-[12px] text-ink-400">
          Generated <time datetime={casino.aiSummary.generatedAt}>{casino.aiSummary.generatedAt}</time>.
        </p>
      </section>
    )
  }

  {
    (casino.license || casino.founded) && (
      <section class="mt-10">
        <h2 id="operator" class="text-[24px]">{heading('operator')}</h2>
        <dl class="mt-3 grid max-w-md grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-[15px]">
          {casino.license && (
            <>
              <dt class="text-ink-400">Licence</dt>
              <dd class="text-ink-100">{casino.license}</dd>
            </>
          )}
          {casino.founded && (
            <>
              <dt class="text-ink-400">Founded</dt>
              <dd class="tabular text-ink-100">{casino.founded}</dd>
            </>
          )}
        </dl>
      </section>
    )
  }
</Base>
