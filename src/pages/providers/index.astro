---
import JsonLd from '../../components/JsonLd.astro';
import ProviderLogo from '../../components/ProviderLogo.astro';
import Base from '../../layouts/Base.astro';
import { getProviders } from '../../lib/providers';
import { absolute, SITE } from '../../lib/site';

const providers = getProviders();
const withSlots = providers.filter((p) => p.slots.length > 0).length;

// Every tile ships in the HTML so the crawler sees the whole directory and the search box
// can match across all of it; the page just shows a slice at a time. Paging on the server
// would hide most of the registry behind URLs nothing links to.
const PAGE_SIZE = 60;
---

<Base
  title={`Casino Game Providers — ${providers.length} Studios | ${SITE.name}`}
  description={`Every game studio we have recorded across the casinos on ${SITE.name} — ${providers.length} of them, from Pragmatic Play and Evolution down to the small in-house teams.`}
  pageType="provider"
>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      '@id': absolute('/providers/'),
      url: absolute('/providers/'),
      name: 'Casino game providers',
      description: `${providers.length} game studios recorded across the casinos on ${SITE.name}.`,
      isPartOf: { '@type': 'WebSite', '@id': absolute('/#website'), name: SITE.name, url: SITE.url },
    }}
  />

  <nav aria-label="Breadcrumb" class="mb-4 text-[14px] text-ink-400">
    <a href="/" class="no-underline hover:text-ink-050">Home</a>
    <span class="mx-1.5">/</span>
    <span class="text-ink-300">Providers</span>
  </nav>

  <h1 class="text-[34px] sm:text-[40px]">Game providers</h1>

  <p class="mt-4 max-w-[62ch] text-ink-300">
    Every studio recorded across the casinos on this site.
  </p>

  <label class="mt-6 block max-w-[420px]">
    <span class="sr-only">Search providers by name</span>
    <input
      type="search"
      id="provider-search"
      placeholder="Search providers"
      autocomplete="off"
      class="w-full rounded-[4px] border border-ink-600 bg-ink-800 px-3 py-2.5 text-ink-050 placeholder:text-ink-400"
    />
  </label>

  <p class="mt-3 text-[14px] text-ink-400" id="provider-count" aria-live="polite">
    {providers.length} providers
  </p>

  <ul
    id="provider-grid"
    class="mt-5 grid grid-cols-2 gap-2.5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
  >
    {
      providers.map((p) => (
        <li data-provider-tile data-name={p.name.toLowerCase()}>
          <a
            href={`/providers/${p.slug}/`}
            title={p.name}
            class="flex h-[92px] items-center justify-center rounded-[4px] border border-ink-600 bg-ink-800 p-3 no-underline transition-colors hover:border-ink-400 hover:bg-ink-700"
          >
            <ProviderLogo slug={p.slug} name={p.name} slotCount={p.slots.length} />
            <span class="sr-only">{p.name}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <p id="provider-empty" hidden class="surface mt-4 p-6 text-ink-300">
    No provider matches that name.
  </p>

  <div class="mt-6 flex justify-center">
    <button
      type="button"
      id="provider-more"
      class="rounded-[4px] border border-ink-600 bg-ink-800 px-5 py-2.5 text-[15px] text-ink-100 hover:border-ink-400 hover:text-ink-050"
    >
      Load more
    </button>
  </div>

  {
    withSlots === 0 && (
      <p class="mt-8 max-w-[62ch] text-[14px] text-ink-400">
        Individual provider pages are still filling up — the games, and the RTP each casino
        runs them at, are being checked by hand one studio at a time.
      </p>
    )
  }
</Base>

<script is:inline define:vars={{ PAGE_SIZE }}>
  // Plain inline script rather than a framework island: this is one list, one input and
  // one counter, and the whole directory is already in the DOM.
  const grid = document.getElementById('provider-grid');
  if (grid) {
    const tiles = [...grid.querySelectorAll('[data-provider-tile]')];
    const search = document.getElementById('provider-search');
    const count = document.getElementById('provider-count');
    const empty = document.getElementById('provider-empty');
    const more = document.getElementById('provider-more');
    let limit = PAGE_SIZE;

    function render() {
      const term = search.value.trim().toLowerCase();
      let matched = 0;
      for (const tile of tiles) {
        const hit = !term || tile.dataset.name.includes(term);
        if (hit) matched++;
        tile.hidden = !hit || matched > limit;
      }
      count.textContent = `${matched}${matched === 1 ? ' provider' : ' providers'}`;
      empty.hidden = matched > 0;
      more.hidden = matched <= limit;
    }

    search.addEventListener('input', () => {
      limit = PAGE_SIZE;
      render();
    });
    more.addEventListener('click', () => {
      limit += PAGE_SIZE;
      render();
    });
    render();
  }
</script>
