---
import { Image } from 'astro:assets';
import JsonLd from '../../components/JsonLd.astro';
import Base from '../../layouts/Base.astro';
import { breadcrumbs } from '../../lib/schema';
import { loadCasinos } from '../../lib/content';
import { getProviders } from '../../lib/providers';
import { getSlots, type SlotView } from '../../lib/slots';
import { slotIcon } from '../../lib/slot-icons';

/**
 * Minimal on purpose. The full slot page — screenshots, mechanics, bonus behaviour — is
 * still to be designed; this exists so the links from provider pages and the casino slot
 * lists resolve the moment a slot record lands, and so both the "where can I play this"
 * list and the RTP-per-casino table have somewhere to live from day one.
 */
export function getStaticPaths() {
  return getSlots().map((slot) => ({ params: { slug: slot.slug }, props: { slot } }));
}

interface Props {
  slot: SlotView;
}

const { slot } = Astro.props;

const providerName =
  getProviders().find((p) => p.slug === slot.provider)?.name ?? slot.provider;
const casinoName = new Map(loadCasinos().map((c) => [c.slug, c.name]));

const checked = slot.rtpByCasino.filter((row) => row.rtp !== null);
const rtpValues = checked.map((row) => row.rtp as number);
const spread =
  rtpValues.length > 1 && Math.min(...rtpValues) !== Math.max(...rtpValues)
    ? { low: Math.min(...rtpValues), high: Math.max(...rtpValues) }
    : null;

// Most-prominent casino first, using the same percentile this page's own ordering runs on.
const availability = [...slot.availability].sort(
  (a, b) => a.position / a.total - b.position / b.total,
);

const icon = slotIcon(slot.slug);
---

<Base
  title={`${slot.name} — Where to Play, by ${providerName}`}
  description={`Which casinos carry ${slot.name} by ${providerName}, and the RTP each one runs it at.`}
  noindex={!slot.indexable}
  pageType="slot"
>
  <JsonLd
    slot="head"
    data={breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'Slots', path: '/slots/' },
      { name: slot.name, path: `/slots/${slot.slug}/` },
    ])}
  />

  <nav aria-label="Breadcrumb" class="mb-4 text-[14px] text-ink-400">
    <a href="/" class="no-underline hover:text-ink-050">Home</a>
    <span class="mx-1.5">/</span>
    <a href="/slots/" class="no-underline hover:text-ink-050">Slots</a>
    <span class="mx-1.5">/</span>
    <span class="text-ink-300">{slot.name}</span>
  </nav>

  <div class="flex items-center gap-4">
    {
      icon && (
        <Image
          src={icon}
          alt=""
          width={72}
          height={94}
          loading="eager"
          class="h-[94px] w-[72px] shrink-0 rounded-[4px] border border-ink-600 object-cover"
        />
      )
    }
    <div>
      <h1 class="text-[30px] sm:text-[34px]">{slot.name}</h1>
      <p class="mt-1.5 text-ink-300">
        by{' '}
        <a href={`/providers/${slot.provider}/`} class="text-amber-400 no-underline hover:text-amber-300">
          {providerName}
        </a>
      </p>
    </div>
  </div>

  <section class="mt-8" aria-labelledby="where">
    <h2 id="where" class="text-[21px]">Where to play it</h2>
    <ul class="tabular mt-3 grid gap-2 sm:grid-cols-2">
      {
        availability.map((row) => (
          <li class="surface flex items-center justify-between p-3">
            <a href={`/casinos/${row.casino}/`} class="no-underline hover:text-amber-400">
              {casinoName.get(row.casino) ?? row.casino}
            </a>
            <a
              href={`/go/${row.casino}`}
              rel="sponsored nofollow noopener"
              target="_blank"
              class="text-[13px] text-ink-400 no-underline hover:text-amber-400"
            >
              Visit ↗
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-8" aria-labelledby="rtp">
    <h2 id="rtp" class="text-[21px]">RTP by casino</h2>

    {
      spread && (
        <p class="mt-2 max-w-[62ch] text-ink-300">
          This game runs at {spread.low}% at one casino and {spread.high}% at another — the
          same title, configured differently. A single headline RTP would be wrong at one
          of them.
        </p>
      )
    }

    {
      slot.rtpByCasino.length === 0 ? (
        <p class="surface mt-3 p-6 text-ink-300">
          Not yet checked at any casino on this site.
        </p>
      ) : (
        <table class="tabular mt-3 w-full border-collapse text-[15px]">
          <thead>
            <tr class="border-b border-ink-600 text-left text-ink-400">
              <th scope="col" class="py-2 pr-4 font-normal">Casino</th>
              <th scope="col" class="py-2 pr-4 font-normal">RTP</th>
              <th scope="col" class="py-2 font-normal">Checked</th>
            </tr>
          </thead>
          <tbody>
            {slot.rtpByCasino.map((row) => (
              <tr class="border-b border-ink-700">
                <td class="py-2 pr-4">
                  <a href={`/casinos/${row.casino}/`} class="no-underline hover:text-amber-400">
                    {casinoName.get(row.casino) ?? row.casino}
                  </a>
                </td>
                <td class="py-2 pr-4">
                  {row.rtp === null ? (
                    <span class="text-ink-400">not verified</span>
                  ) : (
                    `${row.rtp}%`
                  )}
                </td>
                <td class="py-2 text-ink-400">{row.verifiedAt}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </section>

  {slot.summary && <p class="mt-8 max-w-[68ch] text-ink-200">{slot.summary}</p>}
</Base>
