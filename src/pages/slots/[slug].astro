---
import JsonLd from '../../components/JsonLd.astro';
import SlotCasinoCard from '../../components/SlotCasinoCard.astro';
import Base from '../../layouts/Base.astro';
import { breadcrumbs } from '../../lib/schema';
import { loadCasinos } from '../../lib/content';
import { getProviders } from '../../lib/providers';
import { getSlots, type SlotView } from '../../lib/slots';
import { slotIconUrl } from '../../lib/slot-icons';

/**
 * Minimal on purpose. The full slot page — screenshots, mechanics, bonus behaviour — is
 * still to be designed; this exists so the links from provider pages and the casino slot
 * lists resolve the moment a slot record lands, and so the RTP-per-casino table (the
 * reason for the whole exercise) has somewhere to live from day one.
 */
export function getStaticPaths() {
  return getSlots().map((slot) => ({ params: { slug: slot.slug }, props: { slot } }));
}

interface Props {
  slot: SlotView;
}

const { slot } = Astro.props;

const providerName =
  getProviders().find((p) => p.slug === slot.provider)?.name ?? slot.provider;
const casinoBySlug = new Map(loadCasinos().map((c) => [c.slug, c]));

const checked = slot.rtpByCasino.filter((row) => row.rtp !== null);
const rtpValues = checked.map((row) => row.rtp as number);
const spread =
  rtpValues.length > 1 && Math.min(...rtpValues) !== Math.max(...rtpValues)
    ? { low: Math.min(...rtpValues), high: Math.max(...rtpValues) }
    : null;

const rtpByCasino = new Map(slot.rtpByCasino.map((row) => [row.casino, row]));

// Most-prominent casino first, using the same percentile this page's own ordering runs on.
// Only casinos this record actually resolves to — a slot whose availability names a
// casino outside the loaded set (shouldn't happen, validate-content checks it) is
// dropped rather than rendering a half card.
const cards = [...slot.availability]
  .sort((a, b) => a.position / a.total - b.position / b.total)
  .map((row) => casinoBySlug.get(row.casino))
  .filter((c) => c !== undefined);

const iconUrl = slotIconUrl(slot.slug);
---

<Base
  title={`${slot.name} — Where to Play, by ${providerName}`}
  description={`Which casinos carry ${slot.name} by ${providerName}, and the RTP each one runs it at.`}
  noindex={!slot.indexable}
  pageType="slot"
>
  <JsonLd
    slot="head"
    data={breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'Slots', path: '/slots/' },
      { name: slot.name, path: `/slots/${slot.slug}/` },
    ])}
  />

  <nav aria-label="Breadcrumb" class="mb-4 text-[14px] text-ink-400">
    <a href="/" class="no-underline hover:text-ink-050">Home</a>
    <span class="mx-1.5">/</span>
    <a href="/slots/" class="no-underline hover:text-ink-050">Slots</a>
    <span class="mx-1.5">/</span>
    <span class="text-ink-300">{slot.name}</span>
  </nav>

  <div class="flex items-center gap-4">
    {
      iconUrl && (
        <img
          src={iconUrl}
          alt=""
          width="72"
          height="94"
          loading="eager"
          class="h-[94px] w-[72px] shrink-0 rounded-[4px] border border-ink-600 object-cover"
        />
      )
    }
    <div>
      <h1 class="text-[30px] sm:text-[34px]">{slot.name}</h1>
      <p class="mt-1.5 text-ink-300">
        by{' '}
        <a href={`/providers/${slot.provider}/`} class="text-amber-400 no-underline hover:text-amber-300">
          {providerName}
        </a>
      </p>
    </div>
  </div>

  <section class="mt-8" aria-labelledby="where">
    <h2 id="where" class="text-[21px]">RTP and where to play it</h2>
    {
      spread && (
        <p class="mt-2 max-w-[62ch] text-ink-300">
          This game runs at {spread.low}% at one casino and {spread.high}% at another — the
          same title, configured differently. A single headline RTP would be wrong at one
          of them.
        </p>
      )
    }
    {
      cards.length === 0 ? (
        <p class="surface mt-3 p-6 text-ink-300">Not currently listed at a casino on this site.</p>
      ) : (
        <div class="mt-4 flex flex-col gap-3">
          {cards.map((casino) => {
            const row = rtpByCasino.get(casino.slug);
            return (
              <SlotCasinoCard
                casino={casino}
                rtp={row?.rtp ?? null}
                rtpVerifiedAt={row?.verifiedAt ?? null}
              />
            );
          })}
        </div>
      )
    }
  </section>

  {slot.summary && <p class="mt-8 max-w-[68ch] text-ink-200">{slot.summary}</p>}
</Base>
